# SearXNG local configuration example.
# Copy to settings.yml and replace secret_key before use.

use_default_settings: true

general:
  instance_name: "SearXNG (local)"

server:
  secret_key: "CHANGE_ME"
  image_proxy: true

search:
  formats:
    - html
    - json

outgoing:
  request_timeout: 6.0      # 单引擎默认超时（原 3.0）
  max_request_timeout: 8.0  # 整次搜索硬上限

engines:
  # 保留 / 启用：实测能出结果的通用引擎
  - name: google cse
    disabled: false
  - name: bing
    disabled: false
  - name: 360search
    disabled: false
    timeout: 6.0            # 默认 20s，必须覆盖

  # 实测不可用：关闭，避免重启后的首个请求等它们超时
  - name: brave
    disabled: true
  - name: duckduckgo
    disabled: true
  - name: startpage
    disabled: true
